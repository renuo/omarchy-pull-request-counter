#!/bin/bash

# Copies this checkout into the Omarchy user plugin directory and enables it.
#
# A copy rather than a symlink on purpose: the shell watches the plugin
# directory with `inotifywait -r`, which does not descend into symlinked
# directories, so a symlinked plugin would install fine and then never
# hot-reload. Re-run this after editing; the copy itself triggers the reload.

set -euo pipefail

PLUGIN_ID="renuo.pull-request-counter"
SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"

fail() {
  echo "install: $*" >&2
  exit 1
}

command -v omarchy-plugin-validate >/dev/null 2>&1 ||
  fail "omarchy is not installed (omarchy-plugin-validate not on PATH)"

omarchy-plugin-validate "$SOURCE_DIR" || fail "manifest validation failed"

mkdir -p "$TARGET_DIR"

if command -v rsync >/dev/null 2>&1; then
  rsync -a --delete \
    --exclude '.*' \
    --exclude 'bin' \
    --exclude 'docs' \
    --exclude 'test' \
    "$SOURCE_DIR"/ "$TARGET_DIR"/
else
  rm -rf "${TARGET_DIR:?}"/*
  for entry in "$SOURCE_DIR"/*; do
    case "${entry##*/}" in
    bin | docs | test) continue ;;
    esac
    cp -r "$entry" "$TARGET_DIR"/
  done
fi

echo "installed $PLUGIN_ID -> $TARGET_DIR"

# rescanPlugins is belt-and-braces: the inotify watcher already picked up the
# copy, but a first install creates the directory the watcher may not be
# watching yet.
if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

if omarchy-plugin-list 2>/dev/null | grep -q "$PLUGIN_ID.*enabled"; then
  echo "already enabled"
else
  omarchy plugin enable "$PLUGIN_ID" --section right 2>/dev/null ||
    echo "enable it with: omarchy plugin enable $PLUGIN_ID --section right"
fi
