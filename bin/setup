#!/bin/bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

missing=()
for tool in gh jq bats kcov node; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if ((${#missing[@]} > 0)); then
  echo "setup: missing ${missing[*]}" >&2
  echo "setup: sudo pacman -S github-cli jq bash-bats, yay -S kcov, mise use node" >&2
  exit 1
fi
