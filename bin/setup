#!/bin/bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

missing=()
for tool in gh jq bats node ruby bundle; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if ((${#missing[@]} > 0)); then
  echo "setup: missing ${missing[*]}" >&2
  echo "setup: sudo pacman -S github-cli jq bash-bats, and node/ruby via mise" >&2
  exit 1
fi

bundle install
